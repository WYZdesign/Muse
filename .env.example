# ══════════════════════════════════════════════════════════════
# Muse Environment Variables
# Copy to .env.local and fill in values
# ══════════════════════════════════════════════════════════════

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ──
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Mapbox ──
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# ── Push Notifications (Web VAPID) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...

# ── AWS (Rekognition content scanning) ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# ── Cron Jobs ──
CRON_SECRET=...

# ── Embeddings Pipeline (Ollama + Qdrant) ──
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# ── OpenRouter (AI: embeddings, matching, moderation, support, admin) ──
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=google/gemini-3.7-flash

# ── Admin Emails (comma-separated, for moderation panel) ──
ADMIN_EMAILS=admin@wyzdesign.com

# ── Owner (unlimited likes, pro tier auto-assign) ──
NEXT_PUBLIC_OWNER_EMAIL=torree.marcel@gmail.com

# ── Support ──
NEXT_PUBLIC_SUPPORT_EMAIL=support@wyzdesign.com

# ── RevenueCat (in-app purchases on native) ──
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=...
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=...

# ── Backup (Cloudflare R2) ──
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=muse-backups
BACKUP_DIR=C:\Users\you\muse_backups
RETENTION_DAYS=30
