# MUSE App Environment Variables
# Copy this to .env.local and fill in your values

# ─────────────────────────────────────────────
# Required for AI features (OpenRouter)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override default models
# OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
# OPENROUTER_CHAT_MODEL=google/gemini-3.7-flash

# ─────────────────────────────────────────────
# Required for Stripe payments & Connect
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Connect (for marketplace payouts)
# STRIPE_CONNECT_CLIENT_ID=ca_xxx

# ─────────────────────────────────────────────
# Supabase (database, auth, storage)
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─────────────────────────────────────────────
# App URL (used for canonical URLs, referrer headers, OAuth redirects)
NEXT_PUBLIC_APP_URL=https://muse.wyzdesign.com

# ─────────────────────────────────────────────
# OAuth - Instagram (Meta)
# Create app at: https://developers.facebook.com/apps/
# Product: Instagram Basic Display / Instagram Graph API
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret

# ─────────────────────────────────────────────
# OAuth - Facebook (Meta)
# Create app at: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# ─────────────────────────────────────────────
# OAuth - Spotify
# Create app at: https://developer.spotify.com/dashboard/
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ─────────────────────────────────────────────
# OAuth - SoundCloud
# Create app at: https://developers.soundcloud.com/
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
SOUNDCLOUD_CLIENT_SECRET=your_soundcloud_client_secret

# ─────────────────────────────────────────────
# AWS Rekognition (content moderation)
# Get from: AWS Console → IAM → Users → Security credentials
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# ─────────────────────────────────────────────
# Resend (transactional emails)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# ─────────────────────────────────────────────
# VAPID Keys (Push notifications)
# Generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:legal@wyzdesign.com

# ─────────────────────────────────────────────
# NCMEC CyberTipline (CSAM reporting)
# Register at: https://report.cybertip.org → ESP program
NCMEC_ENDPOINT=https://api.cybertip.org/v1
NCMEC_CLIENT_ID=your_ncmec_client_id
NCMEC_CLIENT_SECRET=your_ncmec_client_secret

# ─────────────────────────────────────────────
# Google Maps / Geocoding (optional)
# Get from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─────────────────────────────────────────────
# Admin emails (comma-separated)
# These users get admin access in the app
ADMIN_EMAILS=admin@wyzdesign.com,torree.marcel@gmail.com

# ─────────────────────────────────────────────
# Owner email (for notifications)
OWNER_EMAIL=torree.marcel@gmail.com

# ─────────────────────────────────────────────
# Support email
NEXT_PUBLIC_SUPPORT_EMAIL=info@wyzdesign.com

# ─────────────────────────────────────────────
# Geocoding service (for location features)
# Get from: https://locationiq.com/ or https://opencagedata.com/
GEOCODE_API_KEY=your_geocode_api_key

# ─────────────────────────────────────────────
# Internal (don't change)
NODE_ENV=production