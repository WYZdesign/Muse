# ══════════════════════════════════════════════════════════════
# Muse Environment Variables
# Copy to .env.local and fill in values
# ══════════════════════════════════════════════════════════════

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── Stripe ──
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Embeddings Pipeline (Ollama + Qdrant) ──
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# ── Admin Emails (comma-separated, for moderation panel) ──
ADMIN_EMAILS=admin@wyzdesign.com

# ── Backup (Cloudflare R2) ──
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=muse-backups
BACKUP_DIR=C:\Users\you\muse_backups
RETENTION_DAYS=30
